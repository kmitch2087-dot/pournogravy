# Copy this file to .env.local (which is gitignored) and fill in real values.
# Cloudflare Pages reads these at build time — also add them in the Pages dashboard:
# Settings > Environment variables > Production + Preview.

# Supabase — from Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# Stripe (add later when payments go live)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...            # server-side only — never exposed to client
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...  # server-side only
